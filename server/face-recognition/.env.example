# Copy to .env when running the FastAPI service manually from this directory.
# Generate SECRET_KEY with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# If ADMIN_PASSWORD is blank, the demo launcher generates a temporary password.
ADMIN_USERNAME=admin_user
ADMIN_PASSWORD=
JWT_EXPIRY_HOURS=2

# Local database and rate limiting
FACE_DB_PATH=./data/face_voter_db.sqlite
REDIS_URL=redis://127.0.0.1:6379/0
# Required for shared limits across workers; fail startup if Redis is unavailable.
REQUIRE_REDIS=false
# Legacy pickle import is disabled. Only enable for an offline, trusted migration.
IMPORT_LEGACY_PICKLE=false

# Face matching and liveness thresholds
MATCH_TOLERANCE=0.55
# Persistent CPU processes warmed before API readiness. Use one API process;
# each API process owns this many face workers. Use 2 on memory-limited hosts.
FACE_WORKERS=4
FACE_PROCESSING_TIMEOUT_SECONDS=15
EAR_MIN_CLOSED=0.22
EAR_MIN_OPEN=0.25

# Ganache relayer. The demo launcher supplies the local deployed contract
# address and deterministic development relayer key automatically.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:7545
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_RELAYER_ADDRESS=
BLOCKCHAIN_RELAYER_PRIVATE_KEY=
VOTING_CREDENTIAL_TTL_MINUTES=15
# One inclusion is the local Ganache policy. Use a reviewed value for your chain.
BLOCKCHAIN_CONFIRMATIONS=1

# Browser origins allowed to call this API. Include every frontend origin used.
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Load the bundled academic roster only for a deliberate local demonstration.
SEED_DEMO_ROSTER=false
