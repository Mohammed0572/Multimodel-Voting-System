# Copy to .env for local deployment settings. Never commit .env files.
# make demo uses Ganache on chain ID 1337 and overrides the local contract address.

# Express server (used by `pnpm run serve`)
PORT=8080
NODE_SECRET_KEY=

# Demo administrator. Leave ADMIN_PASSWORD empty to generate a temporary one
# on each `make demo` run; the generated credentials are printed in its terminal.
ADMIN_USERNAME=admin_user
ADMIN_PASSWORD=

# Optional Sepolia deployment settings. Keep the mnemonic private and funded
# only with testnet ETH. These values are not required by `make demo`.
MNEMONIC=
SEPOLIA_RPC_URL=
RELAYER_ADDRESS=

# Vite build-time settings. The demo launcher supplies its deployed local
# contract address and chain ID automatically.
VITE_CONTRACT_ADDRESS=
VITE_NETWORK_ID=1337
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend relayer settings for manually started or deployed services.
# Never put a relayer private key in a VITE_ variable.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:7545
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_RELAYER_ADDRESS=
BLOCKCHAIN_RELAYER_PRIVATE_KEY=
VOTING_CREDENTIAL_TTL_MINUTES=15
